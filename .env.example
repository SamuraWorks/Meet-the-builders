# Gmail account used to send registration emails (server-side only, never exposed to the browser)
# Resend API key used only by the server route to send applications
API_KEY=

# Optional: override the organizer recipient email
FUTURE_BUILDERS_EMAIL=academyfuturebuilders@gmail.com

# Public URL of the deployed site, used for social (Open Graph) preview images
# Example: NEXT_PUBLIC_SITE_URL=https://future-builders.example.com  (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
