# Gmail account used to send registration emails (server-side only, never exposed to the browser)
SMTP_USER=your-sender@gmail.com

# Google App Password (16 characters), NOT your normal Gmail password
# Create one at: https://myaccount.google.com/apppasswords (2-Step Verification must be enabled)
SMTP_PASS=

# Where Future Builders 'Meet the Builders' registration emails + PDFs are delivered
FUTURE_BUILDERS_EMAIL=academyfuturebuilders@gmail.com

# Public URL of the deployed site, used for social (Open Graph) preview images
# Example: NEXT_PUBLIC_SITE_URL=https://future-builders.example.com  (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3001